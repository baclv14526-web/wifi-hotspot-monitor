<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📶 Giám sát Hotspot WiFi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tự động nhắc bật Hotspot khi bị tắt"
            android:textSize="13sp"
            android:textColor="#5C6BC0"
            android:layout_marginBottom="16dp" />

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:id="@+id/tvHotspot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📵 Hotspot: TẮT"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴 Đã dừng"
                android:textSize="14sp"
                android:textColor="#757575" />

        </LinearLayout>

        <!-- Toggle button -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Bắt đầu giám sát"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙️ Mở cài đặt Hotspot"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Chế độ kiểm tra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chế độ kiểm tra"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="12dp" />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Lịch trình cố định (mặc định) -->
                <RadioButton
                    android:id="@+id/radioSchedule"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📅 Theo lịch trình cố định"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:checked="true"
                    android:layout_marginBottom="4dp" />

                <!-- Info lịch trình — hiện khi chọn radioSchedule -->
                <LinearLayout
                    android:id="@+id/layoutScheduleInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="32dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/tvScheduleTimes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="7:00 SA  •  11:00 SA  •  4:00 CH  •  9:00 TỐI"
                        android:textSize="13sp"
                        android:textColor="#5C6BC0" />

                </LinearLayout>

                <!-- Theo chu kỳ phút -->
                <RadioButton
                    android:id="@+id/radioInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱ Theo chu kỳ (phút)"
                    android:textSize="14sp"
                    android:textColor="#212121"
                    android:layout_marginBottom="4dp" />

                <!-- Điều chỉnh phút — hiện khi chọn radioInterval -->
                <LinearLayout
                    android:id="@+id/layoutInterval"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="32dp"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/btnMinus"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="−"
                        android:textSize="20sp"
                        android:padding="0dp" />

                    <TextView
                        android:id="@+id/tvInterval"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="5 phút"
                        android:textSize="17sp"
                        android:textStyle="bold"
                        android:textColor="#212121"
                        android:gravity="center" />

                    <Button
                        android:id="@+id/btnPlus"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:text="+"
                        android:textSize="20sp"
                        android:padding="0dp" />

                </LinearLayout>

            </RadioGroup>
        </LinearLayout>

        <!-- Auto start + Battery -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔄 Tự khởi động sau reboot"
                    android:textSize="14sp"
                    android:textColor="#212121" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <Button
                android:id="@+id/btnBattery"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🔋 Tắt tối ưu pin (Oppo/Realme)"
                android:textSize="13sp" />

        </LinearLayout>


        <!-- Nhạc cảnh báo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎵 Nhạc cảnh báo"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvMp3Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn — dùng chuông mặc định"
                android:textSize="13sp"
                android:textColor="#5C6BC0"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickMp3"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Chọn file .mp3"
                    android:textSize="13sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnClearMp3"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:text="Xóa"
                    android:textSize="13sp"
                    android:visibility="gone" />

            </LinearLayout>
        </LinearLayout>


        <!-- Cảnh báo pin yếu -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔋 Cảnh báo pin yếu"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#1A237E" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchBatteryAlert"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Báo khi pin dưới"
                    android:textSize="13sp"
                    android:textColor="#757575" />

                <Button
                    android:id="@+id/btnBatteryMinus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="−"
                    android:textSize="18sp"
                    android:padding="0dp" />

                <TextView
                    android:id="@+id/tvBatteryThreshold"
                    android:layout_width="52dp"
                    android:layout_height="wrap_content"
                    android:text="20%"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnBatteryPlus"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="+"
                    android:textSize="18sp"
                    android:padding="0dp" />

            </LinearLayout>

        </LinearLayout>

            <!-- MP3 riêng cho cảnh báo pin -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🎵 Nhạc cảnh báo pin"
                android:textSize="13sp"
                android:textColor="#5C6BC0"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvBatteryMp3Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn — dùng nhạc Hotspot hoặc chuông mặc định"
                android:textSize="12sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPickBatteryMp3"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Chọn file .mp3"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnClearBatteryMp3"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Xóa"
                    android:textSize="12sp"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Trên Oppo/Realme: Settings → App → WiFi Monitor → Auto Launch → BẬT"
            android:textSize="12sp"
            android:textColor="#757575"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>