<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Giám sát Hotspot WiFi"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tự động nhắc bật Hotspot khi bị tắt"
            android:textSize="14sp"
            android:textColor="#757575"
            android:layout_marginBottom="20dp" />

        <!-- Trạng thái -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tvHotspot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📵 Hotspot: TẮT"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#212121"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴 Đã dừng"
                android:textSize="15sp"
                android:textColor="#757575" />

        </LinearLayout>

        <!-- Nút bật/tắt giám sát -->
        <Button
            android:id="@+id/btnToggle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Bắt đầu giám sát"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <!-- Nút mở cài đặt Hotspot -->
        <Button
            android:id="@+id/btnSettings"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Mở cài đặt Hotspot"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <!-- Chu kỳ kiểm tra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kiểm tra mỗi"
                android:textSize="14sp"
                android:textColor="#757575"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnMinus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="−"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvInterval"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="5 phút"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:gravity="center" />

                <Button
                    android:id="@+id/btnPlus"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:text="+"
                    android:textSize="20sp" />

            </LinearLayout>
        </LinearLayout>

        <!-- Tự khởi động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Tự khởi động sau khi reboot"
                android:textSize="15sp"
                android:textColor="#212121" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchAutoStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true" />

        </LinearLayout>

        <!-- Tối ưu pin -->
        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Tắt tối ưu pin (Oppo/Realme)"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Oppo/Realme: Vào Settings → Quản lý ứng dụng → WiFi Hotspot Monitor → Khởi động tự động → Bật"
            android:textSize="12sp"
            android:textColor="#757575" />

    </LinearLayout>
</ScrollView>
